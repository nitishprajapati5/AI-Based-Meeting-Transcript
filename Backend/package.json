{
  "name": "ai-meeting-notes",
  "version": "1.12.0",
  "description": "AI-Powered Meeting Notes & Action Item Tracking System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:memory": "ts-node src/db/seedMemory.ts",
    "db:verify:memory": "ts-node src/db/verifyMemory.ts",
    "docs:generate": "ts-node src/scripts/generateDocs.ts",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.50",
    "@ai-sdk/xai": "^4.0.38",
    "@bull-board/api": "^9.3.2",
    "@bull-board/express": "^9.3.2",
    "@bull-board/ui": "^9.5.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.92",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.10",
    "pgvector": "^0.3.0",
    "resend": "^6.21.0",
    "ws": "^8.21.3",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
